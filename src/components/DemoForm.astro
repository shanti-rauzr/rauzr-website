---
import { email } from "../data/site";

interface Props {
  idPrefix: string;
}

const { idPrefix } = Astro.props;
const ids = {
  name: `${idPrefix}-name`,
  company: `${idPrefix}-company`,
  email: `${idPrefix}-email`,
  phone: `${idPrefix}-phone`,
  phoneError: `${idPrefix}-phone-error`,
  note: `${idPrefix}-note`,
  honey: `${idPrefix}-honey`,
  thanks: `${idPrefix}-thanks`,
  error: `${idPrefix}-error`,
};
---

<form
  class="demo-form"
  action={`https://formsubmit.co/${email}`}
  method="post"
>
  <div class="demo-form-fields">
    <input type="hidden" name="_subject" value="Rauzr demo request" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="phone" value="" data-demo-phone-full />
    <div class="sr-only" aria-hidden="true">
      <label for={ids.honey}>Leave blank</label>
      <input id={ids.honey} type="text" name="_honey" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row two">
      <div class="field">
        <label for={ids.name}>Name (optional)</label>
        <input id={ids.name} name="name" type="text" autocomplete="name" />
      </div>
      <div class="field">
        <label for={ids.company}>Company (optional)</label>
        <input id={ids.company} name="company" type="text" autocomplete="organization" />
      </div>
    </div>

    <div class="field">
      <label for={ids.email}>Work email</label>
      <input id={ids.email} name="email" type="email" autocomplete="email" required />
    </div>

    <div class="field">
      <label for={ids.phone}>Mobile number, India (optional)</label>
      <div class="phone-input" data-demo-phone-wrap>
        <span class="phone-prefix" aria-hidden="true">+91</span>
        <input
          id={ids.phone}
          type="tel"
          inputmode="numeric"
          autocomplete="tel-national"
          maxlength="16"
          aria-describedby={ids.phoneError}
          data-demo-phone-local
        />
      </div>
      <p class="field-error" id={ids.phoneError} hidden data-demo-phone-error>
        Enter a 10-digit Indian mobile number starting with 6, 7, 8, or 9.
      </p>
    </div>

    <div class="field">
      <label for={ids.note}>Anything we should know? (optional)</label>
      <textarea id={ids.note} name="note" maxlength="500" rows="3"></textarea>
    </div>

    <button class="btn btn-primary" type="submit" data-demo-submit>Request a demo</button>
  </div>

  <p class="demo-form-thanks" id={ids.thanks} hidden role="status" data-demo-thanks></p>
  <p class="demo-form-error" id={ids.error} hidden role="alert" data-demo-error></p>
</form>
