---
import { u } from "../lib/url";
import Logo from "./Logo.astro";
import { demoMailto, disclaimer, email } from "../data/site";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={u("/")} aria-label="Rauzr home">
          <Logo />
        </a>
        <p>Bring AI to health and life sciences. Agents do the work. Humans review.</p>
      </div>
      <div>
        <p class="footer-title">Products</p>
        <div class="footer-links">
          <a href={u("/products/")}>All products</a>
          <a href={u("/products/helix/")}>Rauzr Helix</a>
          <a class="footer-child" href={u("/products/helix/dossiq/")}>Dossiq</a>
          <span class="footer-child">Full RIM · planned</span>
        </div>
      </div>
      <div>
        <p class="footer-title">Company</p>
        <div class="footer-links">
          <a href={u("/")}>Home</a>
          <a href={u("/approach/")}>How it works</a>
          <a href={u("/company/")}>About Rauzr</a>
          <a href={u("/company/#contact")}>Contact</a>
        </div>
      </div>
      <div>
        <p class="footer-title">Contact</p>
        <div class="footer-links">
          <a href={`mailto:${email}`}>{email}</a>
          <a href={demoMailto}>Request a demo</a>
          <span>Hyderabad</span>
        </div>
      </div>
    </div>
    <div class="footer-meta">
      <p>{disclaimer}</p>
      <p>Veeva and Vault are trademarks of their respective owners. SharePoint is a trademark of Microsoft Corporation. Third-party names are used for identification only and do not imply endorsement or partnership.</p>
      <p>© {new Date().getFullYear()} Rauzr Inc.</p>
    </div>
  </div>
</footer>
