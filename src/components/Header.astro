---
import { u } from "../lib/url";
import Logo from "./Logo.astro";
import { demoMailto, nav } from "../data/site";

const current = Astro.url.pathname;

function isCurrent(href: string, match?: string) {
  if (href === u("/")) return current === href;
  const m = match ?? href;
  return current === m || current.startsWith(m);
}
---

<header class="site-header">
  <div class="container nav-bar">
    <a class="logo" href={u("/")} aria-label="Rauzr home">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {
        nav.map((item) =>
          item.children ? (
            <div class="nav-drop">
              <a
                href={item.href}
                class="nav-drop-trigger"
                aria-haspopup="true"
                aria-current={isCurrent(item.href, item.match) ? "page" : undefined}
              >
                {item.label}
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <div class="nav-drop-panel">
                {item.children.map((c) => (
                  <a href={c.href} class:list={["drop-link", { "drop-child": c.depth === 1 }]}>
                    <span class="drop-label">
                      {c.label}
                      {c.status && <em class:list={["drop-status", { planned: c.status !== "Available" }]}>{c.status}</em>}
                    </span>
                    <span class="drop-note">{c.note}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <a class="btn btn-primary header-cta" href={demoMailto}>Request a demo</a>

    <details class="nav-mobile">
      <summary class="nav-toggle" aria-label="Menu">
        <span></span>
      </summary>
      <div class="nav-panel">
        <nav aria-label="Mobile">
          {
            nav.map((item) => (
              <>
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={current === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
                {item.children && (
                  <div class="nav-sub">
                    {item.children
                      .filter((c) => c.href !== item.href)
                      .map((c) => (
                        <a
                          class:list={["nav-sublink", { "nav-sublink-child": c.depth === 1 }]}
                          href={c.href}
                          aria-current={current === c.href ? "page" : undefined}
                        >
                          {c.label}
                          {c.status && <em class:list={["drop-status", { planned: c.status !== "Available" }]}>{c.status}</em>}
                        </a>
                      ))}
                  </div>
                )}
              </>
            ))
          }
        </nav>
        <a class="btn btn-primary" href={demoMailto}>Request a demo</a>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector(".nav-mobile");
  const header = document.querySelector(".site-header");

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.hasAttribute("open")) {
      menu.removeAttribute("open");
    }
  });

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
