---
const items = [
  "Prepare the dossier",
  "Find discrepancies",
  "Suggest resolution",
  "US CBE-30",
  "EU Type IB",
  "CTD Module 3",
  "Source inventory",
  "Deterministic rules",
  "Findings queue",
  "Document review",
  "Cite-only Ask",
  "Trust tiers",
  "Human disposition",
];
const loop = [...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {loop.map((item) => <span class="marquee-item">{item}</span>)}
  </div>
</div>
<p class="sr-only">Dossiq, the first Rauzr Helix agent, covers {items.join(", ")}.</p>
