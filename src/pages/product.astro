---
// Old URL. Dossiq now lives at /products/helix/dossiq/. Static redirect for GitHub Pages.
import { u } from "../lib/url";
import { siteUrl } from "../data/site";
const target = u("/products/helix/dossiq/");
const canonical = new URL("/products/helix/dossiq/", siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dossiq has moved — Rauzr</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
  </head>
  <body>
    <p>Dossiq has moved to <a href={target}>{canonical}</a>.</p>
  </body>
</html>
