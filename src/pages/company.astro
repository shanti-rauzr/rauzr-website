---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import { email } from "../data/site";
import DemoForm from "../components/DemoForm.astro";

const title = "Company and contact — Rauzr";
const description =
  "Rauzr Inc brings AI to health and life sciences: agents do the work, humans review. Rauzr Helix is our first product. Headquartered in Hyderabad. Contact contact@rauzr.ai.";
---

<Base title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="crumb"><a href={u("/")}>Rauzr</a> <span aria-hidden="true">/</span> Company</p>
      <p class="kicker">Rauzr Inc</p>
      <h1>Bring AI to health and life sciences.</h1>
      <p class="lead">
        Rauzr is building AI agents for regulated health and life sciences work. Agents should do the work; humans review. Our first product is Rauzr Helix, an agent platform for health and life sciences, and its first agent is Dossiq, for regulatory affairs. Dossiq Respond and Regulatory Intelligence are coming soon. Further agents are planned.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>Where we start.</h2>
        <div class="prose" style="margin-top: 1rem">
          <p>
            Generic drug variations — a site change, a specification update, a stability protocol amendment — turn on whether Module 3 still agrees with itself and with the last approved sequence. That review is careful, cross-document, and slow.
          </p>
          <p>
            We build for that bottleneck. Agents prepare the package, find the discrepancies, and suggest how to resolve them. Humans decide and file. Therapies move when the regulatory work moves, and the regulatory work stays with the people who sign it.
          </p>
        </div>
        <dl class="where">
          <div>
            <dt>Headquarters</dt>
            <dd>Hyderabad</dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd>Rauzr Helix</dd>
          </div>
          <div>
            <dt>First agent</dt>
            <dd>Dossiq, for regulatory affairs</dd>
          </div>
        </dl>
      </div>

      <div class="form-card" id="contact">
        <h2 class="form-title" id="demo">Request a demo</h2>
        <p class="form-note">We'll get back to you soon.</p>
        <DemoForm idPrefix="page-demo" />
        <p class="form-note" style="margin-top: 1rem">
          Or email <a href={`mailto:${email}`}>{email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
