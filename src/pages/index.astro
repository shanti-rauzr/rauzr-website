---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import CtaBand from "../components/CtaBand.astro";
import Marquee from "../components/Marquee.astro";
import AgentSteps from "../components/AgentSteps.astro";
import { demoMailto } from "../data/site";
import overview from "../assets/product/package-overview.png";
import findings from "../assets/product/findings-queue.png";
import ask from "../assets/product/package-ask.png";

const title = "Rauzr Helix — AI agents for health and life sciences";
const description =
  "Rauzr Helix is a platform of AI agents for health and life sciences. Dossiq, the first agent product, prepares CTD Module 3 dossiers for US CBE-30 and EU Type IB, finds discrepancies across R&D, QC, and QA documents, and suggests how to resolve them. Humans decide and file.";
---

<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <a class="hero-pill" href={u("/product/")}>
        <span class="hero-pill-tag">First agent</span>
        <span>Dossiq for regulatory affairs</span>
        <span aria-hidden="true">→</span>
      </a>
      <p class="kicker hero-kicker">Rauzr Helix</p>
      <h1>AI agents for health and life sciences.</h1>
      <p class="lead">
        Rauzr Helix is our platform for agents that do the careful document work of regulated life sciences. Rules find the issues, every fact is cited, and people make the call. Dossiq, for regulatory affairs, is the first.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={demoMailto}>Request a demo</a>
        <a class="btn btn-secondary" href={u("/product/")}>Meet Dossiq</a>
      </div>
      <p class="hero-note">Decision support. Rauzr agents do not submit to FDA, EMA, or any other agency.</p>
    </div>

    <div class="hero-stage">
      <Marquee />
      <div class="hero-frame">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-back" aria-hidden="true"></div>
        <div class="hero-shot">
          <Shot
            src={overview}
            eager={true}
            chrome="Dossiq · Package overview"
            alt="Dossiq package overview for a sample Stability Protocol Amendment. The screen shows zero blocking findings, two major findings open, one major waived, section completeness, a CTD Module 3 list with cross-checked and unverified rows, a Tier 1 source-document baseline, recent activity, and an Ask the package panel."
          />
        </div>
      </div>
    </div>
  </section>

  <section class="fact-strip" aria-label="Rauzr Helix and Dossiq at a glance">
    <div class="container">
      <dl class="fact-grid">
        <div>
          <dt>Platform</dt>
          <dd>Rauzr Helix</dd>
        </div>
        <div>
          <dt>First agent</dt>
          <dd>Dossiq, for regulatory affairs</dd>
        </div>
        <div>
          <dt>Scope today</dt>
          <dd>CTD Module 3 · US CBE-30 · EU Type IB</dd>
        </div>
        <div>
          <dt>Decision</dt>
          <dd>Owned by your RA reviewer</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="value-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Dossiq · The first Helix agent</p>
          <h2 id="value-title">More than a prepared dossier. Dossiq finds what disagrees, and suggests the fix.</h2>
        </div>
        <p class="lead">
          Generic variation packages slip between documents: a specification, a method, a stability summary, and the last approved sequence can disagree while each file looks fine on its own. Dossiq agents work across all of them.
        </p>
      </div>
      <AgentSteps />
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="trust-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Trust model</p>
          <h2 id="trust-title">Rules find it. You verify it by asking.</h2>
        </div>
        <p class="lead">
          Findings come from deterministic rules, not a model's opinion: the same package produces the same result every time. Any finding can be double-checked in seconds by asking a question and reading the cited page.
        </p>
      </div>

      <div class="surface surface-tight">
        <div class="surface-copy">
          <p class="index">Rules</p>
          <h3>Every finding names its rule.</h3>
          <p>Severity, CTD section, owner, and state sit on every row. Source is Rule or Human. The drawer keeps the rule id, the linked documents, and the thread.</p>
          <ul class="ticks">
            <li>Same inputs, same result. The model does not vote on pass or fail.</li>
            <li>Blocking, major, and minor stay distinct</li>
            <li>Agree, dispute, or waive with a logged justification</li>
          </ul>
          <a class="text-link" href={u("/product/#findings")}>Open the findings tour</a>
        </div>
        <Shot
          src={findings}
          chrome="Dossiq · Findings queue"
          alt="Dossiq findings queue for a sample package. Findings are listed with severity, CTD section, source marked Rule or Human, owner, and state. A detail drawer shows a rule id, linked documents, and a comment thread."
        />
      </div>

      <div class="surface surface-tight reverse">
        <div class="surface-copy">
          <p class="index">Ask</p>
          <h3>Doubt a finding? Ask the package.</h3>
          <p>Ask runs over the whole package or a slice — a department, a batch, a document — and answers only with citations: document, page, and span. If it cannot cite, it does not answer.</p>
          <ul class="ticks">
            <li>“What does the stability report conclude for this lot?” comes back with the page</li>
            <li>Ask does not create findings or assign severity</li>
            <li>A readiness question is handed back to RA review</li>
          </ul>
          <a class="text-link" href={u("/product/#ask")}>See Ask on a package</a>
        </div>
        <Shot
          src={ask}
          scroll={true}
          chrome="Dossiq · Ask the package"
          alt="Dossiq Ask the package on a sample variation. A cited comparison table lists stability checks from R and D and QC with document and page. The screen labels an observation as not verified and refuses a readiness question, pointing to human review."
        />
      </div>
    </div>
  </section>

  <section class="statement" aria-labelledby="statement-title">
    <div class="container statement-grid">
      <div class="statement-lead">
        <p class="kicker">Judgment</p>
        <h2 id="statement-title">Rules flag it. People decide.</h2>
        <p>Every finding has a rule and a citation. Dossiq keeps machine checks and human judgment separate, and named on the record.</p>
      </div>
      <ol class="owners">
        <li>
          <span class="owner-tag">Model</span>
          <div>
            <h3>Extracts, with a page.</h3>
            <p>Reads R&amp;D, QC, QA, and prior filings. A fact without a document, page, and span is not an answer.</p>
          </div>
        </li>
        <li>
          <span class="owner-tag">Rules</span>
          <div>
            <h3>Find the discrepancy.</h3>
            <p>Deterministic checks compare those facts. The rule id is stored on the finding.</p>
          </div>
        </li>
        <li>
          <span class="owner-tag">RA</span>
          <div>
            <h3>Decides and files.</h3>
            <p>Agree, dispute, waive with a justification, or raise a finding the rules did not.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="guard-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">On the screen</p>
          <h2 id="guard-title">The product says this to the reviewer.</h2>
        </div>
        <p class="lead">Screens are the Dossiq interface with sample data. They are not customer work and not a performance claim.</p>
      </div>
      <div class="quote-grid">
        <figure class="quote">
          <p>“Answers cite source documents only. Pass/fail comes from rules and RA review.”</p>
          <footer>Ask the package</footer>
        </figure>
        <figure class="quote">
          <p>“No severity. No auto-findings. Handoff to Raise finding when you want a disposition.”</p>
          <footer>Ask guardrail</footer>
        </figure>
        <figure class="quote">
          <p>“Ask never auto-creates findings. Voice is an input mode to this same chat.”</p>
          <footer>Ask the package</footer>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="roadmap-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">What's next on Rauzr Helix</p>
          <h2 id="roadmap-title">Dossiq first. More agents to follow.</h2>
        </div>
        <p class="lead">
          Helix is the umbrella for our life sciences agents. Each one is built on the same foundation: cited evidence, deterministic rules, and a person on the decision.
        </p>
      </div>
      <div class="roadmap">
        <article class="road road-now">
          <p class="road-status">Available now</p>
          <h3>Dossiq</h3>
          <p>Regulatory affairs: prepares CTD Module 3, finds discrepancies, and suggests resolutions for US CBE-30 and EU Type IB.</p>
          <a class="text-link" href={u("/product/")}>Explore Dossiq</a>
        </article>
        <article class="road">
          <p class="road-status planned">Planned · Coming later</p>
          <h3>Full RIM</h3>
          <p>Regulatory Information Management beyond a single variation package.</p>
        </article>
        <article class="road">
          <p class="road-status planned">Planned · Coming later</p>
          <h3>More Helix agents</h3>
          <p>Further agents for health and life sciences on the same rules-and-citations foundation.</p>
        </article>
      </div>
      <p class="road-note">Planned products are direction, not commitments. No release dates are announced.</p>
    </div>
  </section>

  <CtaBand />
</Base>
