---
import { Image } from "astro:assets";
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { brandTitle, demoMailto } from "../data/site";
import hero from "../assets/visuals/hero.png";
import howAgents from "../assets/visuals/how-agents.png";
import howRules from "../assets/visuals/how-rules.png";
import howPeople from "../assets/visuals/how-people.png";
import helix from "../assets/visuals/helix.png";

const description =
  "Rauzr brings AI to health and life sciences. Agents do the work; humans review. Rauzr Helix is our agent platform for regulated life sciences work, starting with Dossiq for regulatory affairs.";

const how = [
  {
    img: howAgents,
    n: "01",
    title: "Agents do the work.",
    body: "Agents read the documents, assemble the work product, and compare sources across departments — the slow, careful work that holds up regulated teams.",
    alt: "Illustration: three document cards feeding a Rauzr agent node, with a progress card underneath.",
  },
  {
    img: howRules,
    n: "02",
    title: "Rules and citations make it checkable.",
    body: "Issues are found by deterministic rules, and every fact points to a document, page, and span. Anyone can verify a result by asking and reading the source.",
    alt: "Illustration: a source page with a highlighted span connected to a list of deterministic rule checks and a citation chip.",
  },
  {
    img: howPeople,
    n: "03",
    title: "People review and decide.",
    body: "Your experts agree, dispute, or waive with a reason. Every decision is recorded with a name. Agents never sign off, and never file with an agency.",
    alt: "Illustration: a review card with Agree, Dispute, and Waive actions and a human sign-off badge.",
  },
];

const principles = [
  {
    title: "Cited facts",
    body: "An extracted fact carries its document, page, and span. If an agent cannot cite, it does not answer.",
  },
  {
    title: "Audit trail",
    body: "Rule runs, findings, comments, and decisions are attributed, so a reviewer can walk the record back.",
  },
  {
    title: "Human sign-off",
    body: "Pass, fail, waive, and file belong to people. Agents prepare and suggest; they do not decide.",
  },
  {
    title: "Your data stays yours",
    body: "Your documents are used for your team's review, and the record of findings and decisions belongs to you.",
  },
];
---

<Base title={brandTitle} description={description}>
  <section class="hero home-hero">
    <div class="container">
      <p class="kicker hero-kicker">Rauzr · AI agents for health and life sciences</p>
      <h1>Bring AI to health and life sciences.</h1>
      <p class="hero-sub">Agents do the work. Humans review.</p>
      <p class="lead">
        Rauzr builds AI agents for the document-heavy work of regulated life sciences — for teams in the US, Europe, and beyond — with every finding cited and every decision left to people.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={demoMailto}>Request a demo</a>
        <a class="btn btn-secondary" href={u("/products/helix/")}>Explore Rauzr Helix</a>
      </div>
    </div>
    <div class="hero-visual">
      <Image
        src={hero}
        alt="Illustration of the Rauzr agent pattern: specification, analytical method, and stability report cards flow into a Rauzr agent, which produces a cited discrepancy finding with a suggested fix, followed by a human review card with Agree, Dispute, and Waive."
        widths={[720, 1200, 1800, 2880]}
        sizes="(min-width: 1240px) 1200px, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
        format="webp"
      />
    </div>
  </section>

  <section class="vision" aria-labelledby="vision-title">
    <div class="container vision-grid">
      <div>
        <p class="kicker">Our vision</p>
        <h2 id="vision-title">Agents should do the work. Humans review.</h2>
      </div>
      <div class="vision-copy">
        <p>
          Health and life sciences run on documents: specifications, methods, reports, and filings that must agree with each other and with what regulators already approved. Checking them by hand is slow, and it keeps experts away from judgment.
        </p>
        <p>
          We think agents should carry that load — but only agents that cite their sources and follow rules you can inspect. The people accountable for the decision stay the people who make it.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">How Rauzr agents work</p>
          <h2 id="how-title">Agents do the work. Rules make it checkable. People decide.</h2>
        </div>
        <p class="lead">The same pattern runs through every Rauzr agent, so a reviewer always knows where a result came from and who owns it.</p>
      </div>
      <div class="how-grid">
        {
          how.map((h) => (
            <article class="how-card">
              <div class="how-art">
                <Image src={h.img} alt={h.alt} widths={[480, 720, 1280]} sizes="(min-width: 960px) 380px, 100vw" quality={80} format="webp" />
              </div>
              <div class="how-body">
                <p class="index">{h.n}</p>
                <h3>{h.title}</h3>
                <p>{h.body}</p>
              </div>
            </article>
          ))
        }
      </div>
      <a class="text-link" href={u("/approach/")}>How it works in detail</a>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="products-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Products</p>
          <h2 id="products-title">Rauzr Helix: agents for health and life sciences.</h2>
        </div>
        <p class="lead">Helix is our first product: a platform of agents built on cited evidence, deterministic rules, and human sign-off.</p>
      </div>
      <article class="product-card">
        <div class="product-art">
          <Image
            src={helix}
            alt="Abstract Rauzr Helix visual: a double helix made of small document cards, tagged Dossiq available, Full RIM planned, and more agents planned."
            widths={[720, 1200, 2000]}
            sizes="(min-width: 960px) 640px, 100vw"
            quality={80}
            format="webp"
          />
        </div>
        <div class="product-body">
          <p class="road-status">Available now</p>
          <h3>Rauzr Helix</h3>
          <p>An agent platform for regulated health and life sciences work. Each Helix agent prepares the work, finds issues with rules, suggests resolutions, and hands every decision to a person.</p>
          <a class="nested-line" href={u("/products/helix/dossiq/")}>
            <span class="nested-tag">First agent</span>
            <span><strong>Dossiq</strong> for regulatory affairs</span>
            <span aria-hidden="true">→</span>
          </a>
          <ul class="later">
            <li><span>Full RIM</span><em>Coming later</em></li>
            <li><span>More Helix agents</span><em>Coming later</em></li>
          </ul>
          <a class="btn btn-primary" href={u("/products/helix/")}>Explore Rauzr Helix</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Built for regulated work</p>
          <h2 id="principles-title">Trust is designed in, not added later.</h2>
        </div>
        <p class="lead">Principles every Rauzr agent follows. They describe how the software is built; they are not certifications.</p>
      </div>
      <div class="principles">
        {
          principles.map((p, i) => (
            <article class="principle">
              <span class="principle-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="global" aria-labelledby="global-title">
    <div class="container global-grid">
      <div>
        <p class="kicker">Global</p>
        <h2 id="global-title">Built in Hyderabad for teams worldwide.</h2>
      </div>
      <div>
        <p class="global-copy">For regulated teams in the US, EU, UK, Canada, Australia, and beyond. Aligned to ICH guidelines and the Common Technical Document (CTD) format.</p>
        <ul class="regions" aria-label="Regions served">
          <li>United States</li><li>European Union</li><li>United Kingdom</li><li>Canada</li><li>Australia</li><li>India</li><li>ICH · CTD</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
