---
import { u } from "../../../../lib/url";
import Base from "../../../../layouts/Base.astro";
import Shot from "../../../../components/Shot.astro";
import CtaBand from "../../../../components/CtaBand.astro";
import AgentSteps from "../../../../components/AgentSteps.astro";
import SpeedBand from "../../../../components/SpeedBand.astro";
import { siteUrl } from "../../../../data/site";
import start from "../../../../assets/product/start-variation.png";
import sources from "../../../../assets/product/source-documents.png";
import home from "../../../../assets/product/package-home.png";
import overview from "../../../../assets/product/package-overview.png";
import findings from "../../../../assets/product/findings-queue.png";
import review from "../../../../assets/product/doc-review.png";
import ask from "../../../../assets/product/package-ask.png";

const title = "Dossiq — the first Rauzr Helix agent, for regulatory affairs | Rauzr";
const description =
  "Dossiq, the first agent product on Rauzr Helix, prepares CTD Module 3 for US CBE-30 and EU Type IB, finds discrepancies across R&D, QC, and QA documents with deterministic rules, and suggests how to resolve them. Verify any finding with cite-only Ask. Humans decide and file.";

const software = {
  "@type": "SoftwareApplication",
  name: "Dossiq",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: `${siteUrl}/products/helix/dossiq/`,
  isPartOf: { "@type": "SoftwareApplication", name: "Rauzr Helix", url: `${siteUrl}/products/helix/` },
  provider: {
    "@type": "Organization",
    name: "Rauzr Inc",
    url: siteUrl,
  },
  description:
    "The first agent product on Rauzr Helix. Decision support for generic regulatory affairs: Dossiq prepares CTD Module 3 for US CBE-30 and EU Type IB variations, finds discrepancies across documents, and suggests resolutions. Humans decide and file.",
};
---

<Base title={title} description={description} jsonLd={software}>
  <section class="page-hero">
    <div class="container">
      <p class="crumb"><a href={u("/products/")}>Products</a> <span aria-hidden="true">/</span> <a href={u("/products/helix/")}>Rauzr Helix</a> <span aria-hidden="true">/</span> Dossiq</p>
      <p class="kicker">Dossiq · The first Rauzr Helix agent</p>
      <h1>Prepare the dossier. Find the discrepancies. Suggest the fix.</h1>
      <p class="lead">
        Dossiq agents work across R&amp;D, QC, and QA documents for a generic variation — CTD Module 3, US CBE-30 and EU Type IB. They prepare the package, flag what disagrees, and propose how to resolve it. Your regulatory affairs team decides and files.
      </p>
      <p class="note">
        The screens on this page are the product interface filled with a sample variation. They are not a customer engagement and not a measure of performance.
      </p>
    </div>
  </section>

  <SpeedBand variant="dossiq" />

  <section class="section section-alt" style="padding-block: 4.5rem" aria-labelledby="do-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">What the agents do</p>
          <h2 id="do-title">Three steps, one package.</h2>
        </div>
        <p class="lead">Preparing the dossier is the start. The value is in the discrepancies between documents, and a concrete way to resolve each one.</p>
      </div>
      <AgentSteps />
    </div>
  </section>

  <section class="section" style="padding-block: 4.5rem" aria-labelledby="trust-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Trust model</p>
          <h2 id="trust-title">Rules find it. You verify it by asking.</h2>
        </div>
        <p class="lead">Every finding has a rule and a citation. If you doubt one, ask the package and read the page.</p>
      </div>
      <div class="trust-callout">
        <article>
          <p class="index">Rules</p>
          <h3>Deterministic, and named on the finding.</h3>
          <p>Checks compare cited facts across documents and against the approved baseline. The same inputs give the same result, and the rule id is stored on the finding. The model does not vote on pass or fail.</p>
          <a class="text-link" href="#findings">See the findings queue</a>
        </article>
        <article>
          <p class="index">Ask</p>
          <h3>Double-check any finding with a question.</h3>
          <p>Ask the package answers only with document, page, and span. “What does the QC method test impurity B against?” comes back with the source. Ask never opens, closes, or grades a finding.</p>
          <a class="text-link" href="#ask">See Ask on a package</a>
        </article>
      </div>
    </div>
  </section>

  <section class="tour-block" id="start">
    <div class="container">
      <p class="index">01</p>
      <h2>Start from an approved sequence.</h2>
      <div class="tour-copy">
        <p>
          A variation names its pathway, anchor product, sequence, regions, and the CTD sections it will touch. US CBE-30 and EU Type IB are the pathways Dossiq is built around. The anchor is an approved product and sequence.
        </p>
        <p>
          Scope is explicit: drug substance, drug product, analytical procedures, stability, regional administrative documents. The package can be created or kept as a draft. Nothing is transmitted.
        </p>
      </div>
      <Shot
        src={start}
        chrome="Dossiq · Start a variation"
        alt="Dossiq screen for starting a variation. Fields cover pathway, anchor product and sequence, regions, and CTD scope, with actions to create the package or save a draft."
      />
    </div>
  </section>

  <section class="tour-block" id="sources">
    <div class="container">
      <p class="index">02</p>
      <h2>One inventory for the source documents.</h2>
      <div class="tour-copy">
        <p>
          R&amp;D, QC, and QA documents land in a single list: department, type, version, batch, tier, and status. A row can be read, parsing, queued, or blocked. A scanned specification that produced no text stays blocked. It is not treated as reviewed.
        </p>
        <p>
          Active, reference, and superseded versions stay distinct. Filters cover department, tier, and batch, so a question about one lot does not silently search the whole history.
        </p>
      </div>
      <Shot
        src={sources}
        chrome="Dossiq · Source documents"
        alt="Dossiq source document inventory for a sample variation. Rows list department, document type, version, batch, tier, and status, with filters for department, tier, and batch."
      />
    </div>
  </section>

  <section class="tour-block" id="home">
    <div class="container">
      <p class="index">03</p>
      <h2>Package home is a status, not a score.</h2>
      <div class="tour-copy">
        <p>
          Once the variation exists, home shows blocking findings, major findings still open, major findings waived, and section completeness. Recent activity is attributed: who re-submitted a document, who waived a finding, and that a justification was logged.
        </p>
        <p>
          The baseline sits beside that status, with its trust tier. Tier 1 is a source document — an approved sequence ingested, with the export path recorded. Completeness here describes the sample package on screen. It is not a Rauzr performance figure.
        </p>
      </div>
      <Shot
        src={home}
        chrome="Dossiq · Package home"
        alt="Dossiq package home for a sample variation, with blocking findings, major findings open and waived, section completeness, a CTD section list, baseline trust tier, and recent activity."
      />
    </div>
  </section>

  <section class="tour-block" id="completeness">
    <div class="container">
      <p class="index">04</p>
      <h2>Module 3, section by section.</h2>
      <div class="tour-copy">
        <p>
          The overview lists CTD sections and a state for each: cross-checked against a tier, findings open, or carried and unverified. A carried section is labeled unverified. It is not displayed as a pass.
        </p>
        <p>
          The same screen holds Ask the package, scoped to the whole package, still cite-only. Pass and fail stay with rules and with RA review.
        </p>
      </div>
      <Shot
        src={overview}
        chrome="Dossiq · Section completeness"
        alt="Dossiq overview of CTD Module 3 for a sample Stability Protocol Amendment, including cross-checked sections, open findings, a carried unverified section, a Tier 1 baseline, and the Ask the package panel."
      />
    </div>
  </section>

  <section class="tour-block" id="findings">
    <div class="container">
      <p class="index">05</p>
      <h2>Findings the team can arbitrate.</h2>
      <div class="tour-copy">
        <p>
          The queue filters by severity, status, source, owner, and CTD section. Each row names a rule or marks itself human, and stores linked documents. Critical, major, and minor stay separate. Blocking findings are called out on their own.
        </p>
        <p>
          Inside a finding: the rule id, the documents it used, and a thread. Regulatory affairs can assign, comment, and move state. A waiver requires a justification. RA can also raise a finding the rules did not.
        </p>
      </div>
      <Shot
        src={findings}
        chrome="Dossiq · Findings queue"
        alt="Dossiq findings queue for a sample package. The list shows severity, CTD section, Rule or Human source, owner, and state. The open drawer shows a rule, linked documents, and comments."
      />
    </div>
  </section>

  <section class="tour-block" id="review">
    <div class="container">
      <p class="index">06</p>
      <h2>On the document, marks and a human finding.</h2>
      <div class="tour-copy">
        <p>
          Document review opens the source — a certificate of analysis, a specification, a report — with agent marks on the values the rules are using. A reviewer can agree, keep a mark pending, or dispute it, and can jump to the linked finding.
        </p>
        <p>
          Raise finding is a human action: severity, CTD section, assignee, and a note. Ask on this document is cite-only. It can report what the page says. Disposition goes to the rules or to Raise finding. The model does not judge severity.
        </p>
      </div>
      <Shot
        src={review}
        scroll={true}
        chrome="Dossiq · Document review"
        alt="Dossiq document review of a sample certificate of analysis. Agent marks highlight assay values. The reviewer can agree, dispute, or raise a human finding. Ask on the document cites that document only."
      />
    </div>
  </section>

  <section class="tour-block" id="ask">
    <div class="container">
      <p class="index">07</p>
      <h2>Ask answers. It does not dispose.</h2>
      <div class="tour-copy">
        <p>
          Ask the package runs over the whole package or a slice: R&amp;D, QC, QA, a batch, a document. A comparison comes back as a table — source, condition, timepoints, assay, impurity, lot — with the file and the page. An observation is labeled as not verified when the check has not been run.
        </p>
        <p>
          “Is this package ready to file?” is refused. The product points to readiness gates and to Review &amp; Approve. Ask does not open a finding. Voice is only another way to type the question.
        </p>
        <ul>
          <li>Citations are document, page, and span.</li>
          <li>No severity and no automatic finding from a question.</li>
          <li>Side-by-side and Raise finding are the handoff when a person wants a disposition.</li>
        </ul>
      </div>
      <Shot
        src={ask}
        scroll={true}
        chrome="Dossiq · Ask the package"
        alt="Dossiq Ask the package showing a cited stability comparison across R and D and QC, an observation marked not verified, and a refusal to judge whether the sample package is ready to file."
      />
    </div>
  </section>

  <section class="statement" aria-labelledby="statement-title">
    <div class="container statement-grid">
      <div class="statement-lead">
        <p class="kicker">Judgment</p>
        <h2 id="statement-title">Rules flag it. People decide.</h2>
        <p>Every finding has a rule and a citation. Dossiq keeps machine checks and human judgment separate, and named on the record.</p>
      </div>
      <ol class="owners">
        <li>
          <span class="owner-tag">Model</span>
          <div>
            <h3>Extracts, with a page.</h3>
            <p>Reads R&amp;D, QC, QA, and prior filings. A fact without a document, page, and span is not an answer.</p>
          </div>
        </li>
        <li>
          <span class="owner-tag">Rules</span>
          <div>
            <h3>Find the discrepancy.</h3>
            <p>Deterministic checks compare those facts. The rule id is stored on the finding.</p>
          </div>
        </li>
        <li>
          <span class="owner-tag">RA</span>
          <div>
            <h3>Decides and files.</h3>
            <p>Agree, dispute, waive with a justification, or raise a finding the rules did not.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="guard-title">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">On the screen</p>
          <h2 id="guard-title">The product says this to the reviewer.</h2>
        </div>
        <p class="lead">Screens are the Dossiq interface with sample data. They are not customer work and not a performance claim.</p>
      </div>
      <div class="quote-grid">
        <figure class="quote">
          <p>“Answers cite source documents only. Pass/fail comes from rules and RA review.”</p>
          <footer>Ask the package</footer>
        </figure>
        <figure class="quote">
          <p>“No severity. No auto-findings. Handoff to Raise finding when you want a disposition.”</p>
          <footer>Ask guardrail</footer>
        </figure>
        <figure class="quote">
          <p>“Ask never auto-creates findings. Voice is an input mode to this same chat.”</p>
          <footer>Ask the package</footer>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container trust-grid">
      <div>
        <p class="kicker">Export</p>
        <h2>What leaves the system is for the person who files.</h2>
      </div>
      <div class="prose">
        <p>
          Review &amp; Approve and export are the end of the product’s work. Dossiq can hand a reviewer a package status and a record of findings, citations, and dispositions. It does not transmit a dossier to FDA, EMA, or any other agency.
        </p>
        <p>
          <a href={u("/approach/")}>How judgment, tiers, and the audit posture are split</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand variant="dossiq" />
</Base>
